From a126b25e05bf12068559dc6e667adc27e838d680 Mon Sep 17 00:00:00 2001
From: Aaron Wohl <wohl@awohl.com>
Date: Mon, 23 Nov 2026 08:27:23 -0500
Subject: [PATCH 2/2] VMMakerTests: low space is signalled before old space
 reaches its limit

Add testLowSpaceIsSignalledBeforeOldSpaceReachesItsLimit to
VMSpurScavengerTest.  The test makes the memory map refuse each new
segment, so old space cannot grow.  The test then leaves a fixed
amount of free old space that is above lowSpaceThreshold and below two
new spaces.  sufficientSpaceAfterGC: must answer false, so that the
image gets the low space signal before a scavenge tenures more than
the free old space.

The memory map of the test counts the requests for a segment.  Without
the change, sufficientSpaceAfterGC: asks again without end when a
segment is refused (in the simulation the answer 0 is not nil), so
the test signals TestFailure after 20 requests, and does not hang.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../VMMakerTests/VMSpurScavengerTest.class.st | 39 +++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/smalltalksrc/VMMakerTests/VMSpurScavengerTest.class.st b/smalltalksrc/VMMakerTests/VMSpurScavengerTest.class.st
index 232367cae..1e61c587e 100644
--- a/smalltalksrc/VMMakerTests/VMSpurScavengerTest.class.st
+++ b/smalltalksrc/VMMakerTests/VMSpurScavengerTest.class.st
@@ -338,6 +338,45 @@ VMSpurScavengerTest >> testMethodInStackShouldSurviveScanvenge [
 	self assert: (memory hashBitsOf: newObjectAddress) equals: newObjectHash
 ]
 
+{ #category : 'tests-3-scavenge-basic' }
+VMSpurScavengerTest >> testLowSpaceIsSignalledBeforeOldSpaceReachesItsLimit [
+
+	"The system refuses each new segment, so old space cannot grow.  The free old
+	 space is above lowSpaceThreshold, but less than two new spaces, so one
+	 scavenge can tenure more than old space can take.  Space must be low."
+
+	| refusals refuser freeNow slots answer |
+	"A memory manager that refuses each request, and counts the requests.  Without
+	 the count, a VM that asks again without end would hang the test."
+	refusals := OrderedCollection new.
+	refuser := Object newAnonymousSubclass.
+	refuser addInstVarNamed: 'refusals'.
+	refuser
+		compile: 'refusals: aCollection  refusals := aCollection'
+		classified: 'accessing'.
+	refuser
+		compile: 'allocate: size desiredPosition: position  refusals add: size. refusals size > 20 ifTrue: [ TestFailure signal: ''old space growth is requested again and again'' ]. ^ nil'
+		classified: 'allocating'.
+	memory getMemoryMap memoryManager: (refuser new refusals: refusals; yourself).
+
+	"No limit: the limit path of growOldSpaceByAtLeast:callingOperation: signals an Error in the simulation."
+	memory setMaxOldSpaceSize: 0.
+	memory setHeapGrowthToSizeGCRatio: 2.0.
+	memory lowSpaceThreshold: 1.
+	"Leave a fixed small amount of free old space: above the threshold, below two new spaces."
+	freeNow := memory totalFreeOldSpace.
+	slots := (freeNow - 100000) // memory wordSize - 4.
+	self newOldSpaceObjectWithSlots: slots.
+	memory setHeapSizeAtPreviousGC.
+	self assert: memory totalFreeOldSpace > 1.
+	self assert: memory totalFreeOldSpace < (memory scavenger newSpaceCapacity * 2).
+
+	answer := memory sufficientSpaceAfterGC: 0.
+
+	self assert: refusals notEmpty.
+	self deny: answer
+]
+
 { #category : 'tests-3-scavenge-basic' }
 VMSpurScavengerTest >> testMovingReferencedObjectShouldUpdateReference [
 
-- 
