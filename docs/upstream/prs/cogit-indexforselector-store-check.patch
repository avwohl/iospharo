From e20109222e2621602bd247ac270a034830301ffe Mon Sep 17 00:00:00 2001
From: Aaron Wohl <wohl@awohl.com>
Date: Mon, 23 Nov 2026 08:27:38 -0500
Subject: [PATCH 2/2] VMMakerTests: a followed young literal makes an old
 method remembered

Cogit>>indexForSelector:in:at: follows a forwarded literal of the
method and writes the followed object back into the method.  The new
test builds an old method whose literal is a forwarder to a young
object, calls indexForSelector:in:at: and checks that the literal is
the young object and that the method is in the remembered set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../VMCogitIndexForSelectorTest.class.st      | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)
 create mode 100644 smalltalksrc/VMMakerTests/VMCogitIndexForSelectorTest.class.st

diff --git a/smalltalksrc/VMMakerTests/VMCogitIndexForSelectorTest.class.st b/smalltalksrc/VMMakerTests/VMCogitIndexForSelectorTest.class.st
new file mode 100644
index 000000000..00999bf3e
--- /dev/null
+++ b/smalltalksrc/VMMakerTests/VMCogitIndexForSelectorTest.class.st
@@ -0,0 +1,52 @@
+Class {
+	#name : 'VMCogitIndexForSelectorTest',
+	#superclass : 'VMSimpleStackBasedCogitAbstractTest',
+	#category : 'VMMakerTests-JitTests',
+	#package : 'VMMakerTests',
+	#tag : 'JitTests'
+}
+
+{ #category : 'tests' }
+VMCogitIndexForSelectorTest >> testFollowedYoungLiteralOfOldMethodRemembersTheMethod [
+
+	"A literal of an old method is a forwarder (left by a become:) to a young object.
+	 indexForSelector:in:at: follows the forwarder and writes the followed literal back
+	 into the method.  The write must go through the store check: else the old method
+	 refers to a young object without being in the remembered set."
+
+	| method forwarder selector cogMethod index |
+	self setUpCogMethodEntry.
+
+	"The special selectors are searched first: give them an array of nil."
+	memory coInterpreter specialSelectorArray:
+		(self newOldSpaceObjectWithSlots: 64 "two slots for each of the 32 special selectors").
+
+	selector := self newObjectWithSlots: 0.
+	forwarder := self newOldSpaceObjectWithSlots: 1.
+	memory forward: forwarder to: selector.
+
+	method := methodBuilder
+		          literalAt: 1 put: forwarder;
+		          buildMethod.
+	cogMethod := self
+		             generateCogMethod: [ cogit RetN: 0 ]
+		             selector: memory nilObject.
+	cogMethod methodHeader: (cogit coInterpreter rawHeaderOf: method).
+	cogit coInterpreter rawHeaderOf: method put: cogMethod asInteger.
+	cogMethod methodObject: method.
+
+	self assert: (memory isOld: method).
+	self assert: (memory isYoung: selector).
+	self assert: (memory isForwarded: forwarder).
+	self deny: (memory isRemembered: method).
+
+	index := cogit
+		         indexForSelector: selector
+		         in: cogMethod
+		         at: cogMethod address + (cogit sizeof: CogMethod).
+
+	self
+		assert: (memory fetchPointer: index + 1 ofObject: method)
+		equals: selector.
+	self assert: (memory isRemembered: method)
+]
-- 
