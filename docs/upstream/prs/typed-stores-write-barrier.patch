 		self assert: (memory fetchByte: i ofObject: targetReceiver) equals: 16r90 + i + 1. ].
 ]
 
+{ #category : 'tests - store floats' }
+VMJittedByteArrayAccessPrimitiveTest >> testPrimitiveStoreFloat64DoesNotStoreIfReceiverIsImmutable [
+
+	| target |
+	self genPrimitive: #StoreFloat64.
+	self newReceiver.
+	memory setIsImmutableOf: receiver to: true.
+
+	"A read-only receiver leaves the machine code without a store, and
+	 execution falls through to the stop address.  The caller address is the
+	 stop address too, so that machine code which completes the store and
+	 returns also ends the run there.  The test then fails on the bytes, and
+	 does not run into unmapped memory."
+	target := stop address.
+	callerAddress := target.
+	self prepareStackForSendReceiver: receiver arguments: {
+			(self memory integerObjectOf: 0).
+			(self memory floatObjectOf: 42.0) }.
+	self runFrom: cogInitialAddress until: target.
+
+	0 to: 9 do: [ :i |
+		self assert: (memory fetchByte: i ofObject: targetReceiver) equals: 16r90 + i + 1 ]
+]
+
