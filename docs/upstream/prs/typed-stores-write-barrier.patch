 { #category : 'primitive generators' }
 CogObjectRepresentationForSpur >> genPrimitiveStore: accessedElementByteSize intoBytesWith: aBlock needsToTrap: needsToTrap [
 
-	| nSlotsOrBytesReg jumpBadIndex formatReg jumpIsPointers jumpOutOfBounds jumpSmaller jumpImmediate destPointerRegister |
+	| nSlotsOrBytesReg jumpBadIndex formatReg jumpIsPointers jumpOutOfBounds jumpSmaller jumpImmediate jumpImmutable destPointerRegister |
+	<var: #jumpImmutable type: #'AbstractInstruction *'>
 	nSlotsOrBytesReg := ClassReg.
 	destPointerRegister := ClassReg.
 
@@ -1769,6 +1770,11 @@ CogObjectRepresentationForSpur >> genPrimitiveStore: accessedElementByteSize int
 	cogit genLoadArgAtDepth: 0 into: Arg1Reg.
 	
 	jumpImmediate := self genJumpImmediate: ReceiverResultReg.
+	"A read-only receiver leaves the machine code version without a store.  The C primitive (64-bit values)
+	 or the fallback code of the method then handles the read-only case."
+	self
+		cppIf: IMMUTABILITY
+		ifTrue: [jumpImmutable := self genJumpImmutable: ReceiverResultReg scratchReg: TempReg].
 	jumpBadIndex := self genJumpNotSmallInteger: Arg0Reg scratchReg: TempReg.
 	self genConvertSmallIntegerToIntegerInReg: Arg0Reg.
 	
@@ -1806,6 +1812,9 @@ CogObjectRepresentationForSpur >> genPrimitiveStore: accessedElementByteSize int
 	self genConvertIntegerToSmallIntegerInReg: Arg0Reg.
 	
 	jumpBadIndex jmpTarget: (jumpImmediate jmpTarget: cogit Label).
+	self
+		cppIf: IMMUTABILITY
+		ifTrue: [jumpImmutable jmpTarget: jumpImmediate getJmpTarget].
 	^ needsToTrap ifTrue: [0] ifFalse: [CompletePrimitive]
 ]
 
