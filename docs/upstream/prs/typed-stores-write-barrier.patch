+{ #category : 'tests' }
+VMByteArrayAccessPrimitive >> testFFIIntegerAtPut64bitFailsIfReceiverIsImmutable [
+
+	| array |
+	array := self new8BitIndexableOfSize: 8.
+	memory setIsImmutableOf: array to: true.
+
+	interpreter push: array.
+	interpreter push: (memory integerObjectOf: 1).
+	interpreter push: (memory integerObjectOf: 7).
+	interpreter push: (memory integerObjectOf: 8).
+	interpreter push: memory falseObject.
+	interpreter primitiveFFIIntegerAtPut.
+
+	self assert: interpreter failed.
+	self assert: interpreter primFailCode equals: PrimErrNoModification.
+	0 to: 7 do: [ :index |
+		self assert: (memory fetchByte: index ofObject: array) equals: 0 ]
+]
+
+{ #category : 'tests' }
+VMByteArrayAccessPrimitive >> testFFIIntegerAtPutFailsIfReceiverIsImmutable [
+
+	| array |
+	array := self new8BitIndexableOfSize: 8.
+	memory setIsImmutableOf: array to: true.
+
+	interpreter push: array.
+	interpreter push: (memory integerObjectOf: 1).
+	interpreter push: (memory integerObjectOf: 7).
+	interpreter push: (memory integerObjectOf: 4).
+	interpreter push: memory falseObject.
+	interpreter primitiveFFIIntegerAtPut.
+
+	self assert: interpreter failed.
+	self assert: interpreter primFailCode equals: PrimErrNoModification.
+	0 to: 7 do: [ :index |
+		self assert: (memory fetchByte: index ofObject: array) equals: 0 ]
+]
+
+{ #category : 'tests' }
+VMByteArrayAccessPrimitive >> testFFIIntegerAtPutThroughExternalAddressStoresEvenIfAddressObjectIsImmutable [
+
+	| array externalAddress |
+	memory classExternalAddress: (self newClassInOldSpaceWithSlots: 0 instSpec: (memory byteFormatForNumBytes: 0)).
+	array := self new8BitIndexableOfSize: 8.
+	"The ExternalAddress points to the data of array.  Its own bytes are not the target of the store."
+	externalAddress := memory instantiateClass: memory classExternalAddress indexableSize: memory wordSize.
+	memory storePointer: 0 ofObject: externalAddress withValue: (memory firstBytePointerOfDataObject: array).
+	memory setIsImmutableOf: externalAddress to: true.
+
+	interpreter push: externalAddress.
+	interpreter push: (memory integerObjectOf: 1).
+	interpreter push: (memory integerObjectOf: 7).
+	interpreter push: (memory integerObjectOf: 4).
+	interpreter push: memory falseObject.
+	interpreter primitiveFFIIntegerAtPut.
+
+	self deny: interpreter failed.
+	self assert: (memory fetchByte: 0 ofObject: array) equals: 7
+]
+
 { #category : 'tests' }
 VMByteArrayAccessPrimitive >> testFFIntegerAtPutWithMin64bitLargeNegativeInteger [
 
