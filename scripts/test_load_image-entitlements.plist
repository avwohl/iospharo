<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow lldb / Instruments to attach to the process for debugging.
         Without this, on macOS:
           process attach hangs / fails
           process launch via lldb hangs at the launch
         (deferred.md A1 P0 — needed to investigate JIT_DEFER<4 bugs.)
    -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
    <!-- JIT entitlements (already needed at runtime for MAP_JIT pages
         and asmjit code execution).  Kept here so re-signing for
         debug doesn't accidentally drop them.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
