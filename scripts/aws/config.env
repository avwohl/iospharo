# config.env — shared settings for the iospharo x64 build spot instance.
# Sourced by provision.sh and the on-instance scripts. No secrets here.

AWS_ACCOUNT_ID=670060058357
# Instance region.  Moved off us-east-1 to us-east-2 (Ohio): us-east-1's m-family
# spot pools (esp. 1b) reclaimed this fresh account ~every 20 min; Ohio has
# deeper spare capacity for low-priority spot.  Change freely to relocate.
export AWS_DEFAULT_REGION=us-east-2
# The S3 bucket stays in its home region (cross-region access is transparent),
# so the runbook + history aren't re-created when the instance region changes.
BUCKET_REGION=us-east-1

# Resource names (one project => one of each).
PROJECT_TAG=iospharo-x64
BUCKET=iospharo-build-${AWS_ACCOUNT_ID}
KEY_NAME=iospharo-x64
SG_NAME=iospharo-x64-sg
ROLE_NAME=iospharo-x64-role
PROFILE_NAME=iospharo-x64-profile
INSTANCE_NAME=pharo-x64-builder

# Spot instance shape.  16 vCPU / 64 GiB (m6a.4xlarge): big-pool spot is
# reclaimed far less than small types (per operator experience running 96-core
# spot uninterrupted), and 16 cores ~halves the C++ build for the iterative
# Sista port.  NOTE: this fresh account has a hidden new-account spot cap below
# 16 vCPU (16-vCPU spot returns MaxSpotInstanceCountExceeded despite a displayed
# 32-vCPU quota), so spot will likely fall back to ON-DEMAND here — which fits
# the 16-vCPU on-demand quota exactly and is never reclaimed (also fine for dev).
INSTANCE_TYPE="${INSTANCE_TYPE:-m6a.4xlarge}"
INSTANCE_TYPE_FALLBACKS="${INSTANCE_TYPE_FALLBACKS:-m6i.4xlarge m5.4xlarge m5a.4xlarge}"
ROOT_VOLUME_GB=80
# Last-resort on-demand fallback if spot is unavailable/quota-capped.  On-demand
# Standard quota is 16 vCPU, so a 16-vCPU box fits exactly.  Set 0 to force spot.
ALLOW_ONDEMAND=1
# Skip the spot pass and launch on-demand directly.
#
# Was 1 from ~2026-06: this account's spot was reclaimed ~every 10 min even at
# 16 vCPU (4 reclaims observed), which killed the multi-minute SUnit-under-Sista
# verification runs the port needs.  One casualty of that era is still visible in
# the history -- the `wip(x64): autosave on spot-interruption` commit that
# created the old jit-arm-linux branch (see
# docs/history/branch-consolidation-2026-08-13.md).
#
# 2026-08-13: briefly set to 0, then PUT BACK TO 1 the same day.  Do not flip
# this again without repeating the full-suite test below -- a short build
# succeeding on spot proves nothing.
#
# What looked encouraging: placement score 9/10 for the four candidate types in
# us-east-2, spot ~$0.257/hr against ~$0.69 on-demand (~63% cheaper), and a
# ~50s ccache-hit build that ran on spot with no reclaim.
#
# What actually happened on a real workload.  A full-suite run (x86-fullsuite.sh,
# the ~7h 2045-class suite) was reclaimed 17 minutes in:
#
#     launched     2026-08-13 20:55:08 GMT   m5.4xlarge spot
#     terminated   2026-08-13 21:12:14 GMT   Server.SpotInstanceTermination
#     spot status  instance-terminated-no-capacity
#                  "no Spot capacity available that matches your request"
#     progress     ~14,700 test results in, of a multi-hour suite
#
# That is the same failure mode as 2026-06, unchanged.  Capacity was already
# visibly tight at launch: m6a.4xlarge had NO spot in any of the three AZs and
# neither did m6i.4xlarge -- it took seven attempts to land on m5.4xlarge, and
# that pool then ran dry under us.  Placement score did not predict it.
#
# Short builds on spot are fine (~10 min, and clone-and-build is ccache-backed).
# If you want that saving, gate it per-job rather than globally -- e.g. run
# provision.sh with FORCE_ONDEMAND=0 in the environment for build-only boxes and
# leave the default at 1 so long verification runs stay on-demand.
# Overridable from the environment so a job can opt into spot deliberately
# (see the history above for why the DEFAULT stays 1).
FORCE_ONDEMAND="${FORCE_ONDEMAND:-1}"

# Git: the x86 port pushes to its own branch so it never clobbers the arm
# work happening in parallel on `jit`.  Local does the deliberate merge.
GIT_REMOTE=git@github.com:avwohl/iospharo.git
BASE_BRANCH=jit
# x86 work was merged into jit (2026-06-17) and jit-x86 deleted; the box now
# works on jit directly.  Set WORK_BRANCH=... for a throwaway/topic branch.
WORK_BRANCH="${WORK_BRANCH:-jit}"
DEPLOY_KEY_TITLE=iospharo-x64-deploy

# Idle auto-terminate after this many seconds with no activity.  Overridable from
# the environment: e.g. IDLE_SECONDS=86400 ./provision.sh for a long unattended
# sweep where the keep-alive lease (not the on-box timer) governs the box.
IDLE_SECONDS="${IDLE_SECONDS:-1800}"

# Keep-alive lease registry (aws_watch's instance_lease table on awohl.com).
# provision.sh registers the box here; an actively-working Claude heartbeats it
# via a PostToolUse hook (aws-lease-beat-hook.sh); teardown.sh releases it.  The
# aws-lease SSH key is locked down to ONLY touch lease rows (forced command).
# See scripts/aws/README.md "Keep-alive leases" for one-time key setup.
AWS_LEASE_HOST="${AWS_LEASE_HOST:-wohl@awohl.com}"
AWS_LEASE_PORT="${AWS_LEASE_PORT:-24}"
AWS_LEASE_KEY="${AWS_LEASE_KEY:-$HOME/.ssh/aws-lease}"

# Local file where provision.sh records live resource IDs (gitignored).
STATE_FILE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/state.env"
