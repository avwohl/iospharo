# config-arm.env — settings for the iospharo arm64 (AWS Graviton) build box.
# Sourced INSTEAD of config.env by passing CONFIG_FILE to provision.sh:
#
#   CONFIG_FILE=scripts/aws/config-arm.env ./scripts/aws/provision.sh
#
# Coexists with the x86_64 setup (config.env): distinct key/SG/role/instance
# names, same account + region + S3 bucket.  No secrets here.

AWS_ACCOUNT_ID=670060058357
# Graviton (c7g/c8g/m7g) is available in us-east-2; keep the same region as the
# x86 box so the shared bucket + runbook stay co-located.
export AWS_DEFAULT_REGION=us-east-2
BUCKET_REGION=us-east-1

# Build architecture — drives the Ubuntu 24.04 AMI selection in provision.sh
# (.../current/${ARCH}/hvm/...).  arm64 = Graviton.
ARCH=arm64

# Resource names — separate set so teardown of one arch never touches the other.
PROJECT_TAG=iospharo-arm
BUCKET=iospharo-build-${AWS_ACCOUNT_ID}     # shared with x86 (same account store)
KEY_NAME=iospharo-arm
SG_NAME=iospharo-arm-sg
ROLE_NAME=iospharo-arm-role
PROFILE_NAME=iospharo-arm-profile
INSTANCE_NAME=pharo-arm-builder

# Spot instance shape.  c7g.16xlarge = 64 vCPU / 128 GiB (Graviton3,
# compute-optimized) — fits the CURRENT 64-vCPU Standard-Spot quota exactly and
# is a genuinely large box for fast native-arm64 builds + parallel SUnit shards.
# Fallbacks step DOWN so provisioning still succeeds under capacity/quota limits.
#
# After the pending quota increases approve (both Standard quotas -> 128 vCPU;
# requests submitted 2026-06-06: on-demand L-1216C47A, spot L-34B43A08), bump
# this to c8g.24xlarge (96 vCPU, Graviton4) for the largest practical box.
# (env-overridable so the on-demand recipe below actually works — a plain
#  assignment would clobber any pre-set env var when this file is sourced.)
INSTANCE_TYPE="${INSTANCE_TYPE:-c7g.16xlarge}"
INSTANCE_TYPE_FALLBACKS="${INSTANCE_TYPE_FALLBACKS:-c7g.8xlarge c6g.8xlarge c7g.4xlarge c6g.4xlarge}"
ROOT_VOLUME_GB="${ROOT_VOLUME_GB:-80}"

# Spot first (it's the only path to a >16-vCPU box until the on-demand quota
# increase lands — on-demand Standard is currently capped at 16 vCPU).  Falls
# back to on-demand (<=16 vCPU today) if spot capacity is unavailable.
#
# CONFIRMED 2026-06-06: this account's Graviton spot is reclaimed FAST — the
# first c7g.16xlarge spot box was reclaimed (Server.SpotInstanceTermination)
# ~17 min after launch, mid-smoke-test (same behavior config.env documents for
# x86 spot).  The build still completed (arm64 ELF, booted Pharo headless), but
# multi-minute runs (smoke, SUnit) need stability.  For those, run on-demand:
#   FORCE_ONDEMAND=1 INSTANCE_TYPE=c7g.4xlarge CONFIG_FILE=scripts/aws/config-arm.env ./scripts/aws/provision.sh
# (c7g.4xlarge = 16 vCPU fits the current on-demand quota; bump to c7g.16xlarge /
# c8g.24xlarge once the pending on-demand quota increase to 128 vCPU approves.)
ALLOW_ONDEMAND="${ALLOW_ONDEMAND:-1}"
FORCE_ONDEMAND="${FORCE_ONDEMAND:-0}"

# Git: arm64 Linux-port build changes (the #ifdef __linux__ shims the scoping
# turns up) land on their own branch so they never clobber the macOS `jit` work.
GIT_REMOTE=git@github.com:avwohl/iospharo.git
BASE_BRANCH=jit
WORK_BRANCH="${WORK_BRANCH:-jit-arm-linux}"
DEPLOY_KEY_TITLE=iospharo-arm-deploy

# Idle auto-terminate after this many seconds with no activity.
IDLE_SECONDS=1800

# Local file where provision.sh records live resource IDs (gitignored).
# Separate from the x86 state.env so both can be tracked independently.
STATE_FILE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/state-arm.env"
