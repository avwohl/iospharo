diff --git a/src/OpenAPI-Core-Tests/OAVisitorSpy.class.st b/src/OpenAPI-Core-Tests/OAVisitorSpy.class.st
new file mode 100644
index 0000000..d54bb92
--- /dev/null
+++ b/src/OpenAPI-Core-Tests/OAVisitorSpy.class.st
@@ -0,0 +1,25 @@
+Class {
+	#name : #OAVisitorSpy,
+	#superclass : #OAVisitor,
+	#instVars : [
+		'visitedOpenAPIs'
+	],
+	#category : #'OpenAPI-Core-Tests'
+}
+
+{ #category : #initialization }
+OAVisitorSpy >> initialize [
+	super initialize.
+	visitedOpenAPIs := OrderedCollection new
+]
+
+{ #category : #visiting }
+OAVisitorSpy >> visitOpenAPI: anOpenAPI [
+	visitedOpenAPIs add: anOpenAPI.
+	super visitOpenAPI: anOpenAPI
+]
+
+{ #category : #accessing }
+OAVisitorSpy >> visitedOpenAPIs [
+	^ visitedOpenAPIs
+]
diff --git a/src/OpenAPI-Core-Tests/OAVisitorTest.class.st b/src/OpenAPI-Core-Tests/OAVisitorTest.class.st
index bdfcc4b..27c66d3 100644
--- a/src/OpenAPI-Core-Tests/OAVisitorTest.class.st
+++ b/src/OpenAPI-Core-Tests/OAVisitorTest.class.st
@@ -22,16 +22,12 @@ OAVisitorTest >> setUp [
 
 { #category : #tests }
 OAVisitorTest >> testVisit [
-	| visitedObject |
-	
-	"Create a mock visitor that tracks visited objects"
-	visitor := Mock new.
-	visitor stub openApi willReturn: openAPI.
-	visitor stub visitOpenAPI: Any.
-	
-	"Visit the OpenAPI object"
-	visitor visit: openAPI.
-	
-	"Verify that visitOpenAPI: was called with the openAPI object"
-	visitor should receive visitOpenAPI: openAPI.
-]
\ No newline at end of file
+	| spy |
+	"The visitor is a real OAVisitor that records what it visits.  A Mocketry
+	mock cannot check this: a mock answers #visit: itself and never sends
+	#visitOpenAPI:."
+	spy := OAVisitorSpy new.
+	spy visit: openAPI.
+
+	self assert: spy visitedOpenAPIs asArray equals: { openAPI }
+]
