+Class {
+	#name : #OAInfo,
+	#superclass : #Object,
+	#instVars : [
+		'title',
+		'version',
+		'description',
+		'termsOfService',
+		'contact',
+		'license'
+	],
+	#category : #'OpenAPI-Core-Model'
+}
+
+{ #category : #'as yet unclassified' }
+OAInfo class >> neoJsonMapping: mapper [
+	mapper for: self do: [ :mapping |
+		mapping mapInstVars: #( title version description termsOfService ).
+		(mapping mapInstVar: #contact) valueSchema: OAContact.
+		(mapping mapInstVar: #license) valueSchema: OALicense ]
+]
+
+{ #category : #visiting }
+OAInfo >> accept: aVisitor [
+	aVisitor visitInfo: self
+]
+
+{ #category : #accessing }
+OAInfo >> title [
+	^ title
+]
+
+{ #category : #accessing }
+OAInfo >> title: anObject [
+	title := anObject
+]
+
+{ #category : #accessing }
+OAInfo >> version [
+	^ version
+]
+
+{ #category : #accessing }
+OAInfo >> version: anObject [
+	version := anObject
+]
+
+{ #category : #accessing }
+OAInfo >> description [
+	^ description
+]
+
+{ #category : #accessing }
+OAInfo >> description: anObject [
+	description := anObject
+]
+
+{ #category : #accessing }
+OAInfo >> termsOfService [
+	^ termsOfService
+]
+
+{ #category : #accessing }
+OAInfo >> termsOfService: anObject [
+	termsOfService := anObject
+]
+
+{ #category : #accessing }
+OAInfo >> contact [
+	^ contact
+]
+
+{ #category : #accessing }
+OAInfo >> contact: anObject [
+	contact := anObject
+]
+
+{ #category : #accessing }
+OAInfo >> license [
+	^ license
+]
+
+{ #category : #accessing }
+OAInfo >> license: anObject [
+	license := anObject
+]
