fix value: #FamixJavaMethod value: #isConstructor
	value: [ :source | source includesSubstring: '^ false' ]
	value:
'isConstructor

	<FMProperty: #isConstructor type: #Boolean>
	<FMComment: ''Is the method a constructor for its class?''>
	<derived>
	^ #constructor = self kind or: [ self cacheAt: #isConstructor ifAbsent: [ false ] ]'.

Smalltalk at: #CrfPatch put: [ :className :selector :old :new | | cls |
	cls := Smalltalk globals at: className ifAbsent: [ nil ].
	(cls notNil and: [ cls includesSelector: selector ])
		ifFalse: [ Stdio stdout nextPutAll: 'SKIP ', className, '>>', selector, ' (absent)'; lf; flush ]
		ifTrue: [ | source |
			source := (cls >> selector) sourceCode.
			(source includesSubstring: old)
				ifFalse: [ Stdio stdout nextPutAll: 'SKIP ', className, '>>', selector, ' (defect not present)'; lf; flush ]
				ifTrue: [
					cls compile: (source copyReplaceAll: old with: new) classified: (cls >> selector) protocolName.
					Stdio stdout nextPutAll: 'FIXED ', className, '>>', selector; lf; flush ] ] ].

