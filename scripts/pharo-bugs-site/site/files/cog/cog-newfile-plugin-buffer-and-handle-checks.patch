From b76510a5b3f680ffcbbe8424683b3a1fda2727e9 Mon Sep 17 00:00:00 2001
From: Aaron Wohl
Date: Tue, 17 Nov 2026 13:42:21 -0500
Subject: [PATCH 1/2] NewFilePlugin: check the buffer and the handle objects in
 the primitives

The read and write primitives (primitiveFileReadInto,
primitiveFileReadIntoAtFileOffset, primitiveFileWriteFrom,
primitiveFileWriteFromAtFileOffset) gave the address of the buffer to C
without a check.  Measured on stock Cog v12.0.6 (macOS arm64):
 - a read of 3 bytes into a ByteArray of 2 bytes answers 3 (the plugin
   writes past the buffer);
 - a read into an Array answers 2 (the plugin writes bytes into pointer
   slots);
 - a read into a read-only ByteArray answers 2.

The primitives now call checkBuffer:offset:size:forRead:.  The buffer must
be a data object without pointers (isWordsOrBytes:, so not an Array and not
a CompiledMethod), offset + size must not be more than byteSizeOf: the
buffer (written so that it cannot overflow), and a buffer for a read must
not be immutable.  Otherwise the primitive fails with PrimErrBadArgument,
PrimErrBadIndex or PrimErrNoModification, before any C call.

The handle objects (ExternalAddress) were read with firstIndexableField:
without a check, so a SmallInteger or a short object gave a wild read.
handleValueOf: now fails the primitive unless the handle is a byte object of
BytesPerWord bytes.

primitiveFileOpen, primitiveDirectoryOpen, primitiveDirectoryNext and
primitiveMemoryMapWithProtection allocated an ExternalAddress and then used
oops (path, handle) that were read before the allocation, which can move
young objects.  They now read the path and the handle after the allocation,
and do nothing when the allocation failed.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 smalltalksrc/VMMaker/NewFilePlugin.class.st | 96 +++++++++++++++++----
 1 file changed, 78 insertions(+), 18 deletions(-)

diff --git a/smalltalksrc/VMMaker/NewFilePlugin.class.st b/smalltalksrc/VMMaker/NewFilePlugin.class.st
index 8e8bed04b..a7ed070d3 100644
--- a/smalltalksrc/VMMaker/NewFilePlugin.class.st
+++ b/smalltalksrc/VMMaker/NewFilePlugin.class.st
@@ -27,6 +27,41 @@ NewFilePlugin class >> requiresPlatformFiles [
 	^true
 ]
 
+{ #category : 'private' }
+NewFilePlugin >> checkBuffer: bufferOop offset: bufferOffset size: transferSize forRead: isRead [
+	"Answer true if bufferOop is a data object without pointers (bytes, 16-bit, 32-bit or 64-bit
+	 elements; not a compiled method) that holds bufferOffset + transferSize bytes, and, for a read
+	 into the buffer, is not immutable.  Otherwise fail the primitive and answer false.  The plugin
+	 writes or reads the bytes at firstIndexableField + bufferOffset, so nothing else may reach C."
+	<var: 'bufferOffset' type: #usqInt>
+	<var: 'transferSize' type: #usqInt>
+	<var: 'bufferSize' type: #usqInt>
+	| bufferSize |
+	(interpreterProxy isWordsOrBytes: bufferOop) ifFalse: [
+		interpreterProxy primitiveFailFor: PrimErrBadArgument.
+		^false ].
+	(isRead and: [ interpreterProxy isOopImmutable: bufferOop ]) ifTrue: [
+		interpreterProxy primitiveFailFor: PrimErrNoModification.
+		^false ].
+	bufferSize := interpreterProxy byteSizeOf: bufferOop.
+	"No overflow: bufferOffset <= bufferSize first, then the subtraction cannot wrap."
+	(bufferOffset <= bufferSize and: [ transferSize <= (bufferSize - bufferOffset) ]) ifFalse: [
+		interpreterProxy primitiveFailFor: PrimErrBadIndex.
+		^false ].
+	^true
+]
+
+{ #category : 'private' }
+NewFilePlugin >> handleValueOf: handleOop [
+	"Answer the C value in the ExternalAddress handleOop (the plugin keeps a handle token there).
+	 Fail the primitive if handleOop is not a byte object of the size of a pointer: the plugin must
+	 not read a pointer out of a SmallInteger, nil, or a short object."
+	<returnTypeC: #'void *'>
+	((interpreterProxy isBytes: handleOop) and: [ (interpreterProxy byteSizeOf: handleOop) = BytesPerWord ]) ifFalse: [
+		^self cCoerce: (interpreterProxy primitiveFailFor: PrimErrBadArgument) to: #'void *' ].
+	^self cCoerce: (self pointerAtPointer: (interpreterProxy firstIndexableField: handleOop)) to: #'void *'
+]
+
