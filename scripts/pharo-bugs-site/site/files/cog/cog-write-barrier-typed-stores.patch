 	byteSize := objectMemory numBytesOf: rcvr.
 	(index < 0 or: [index >= (byteSize - 3) or: [byteSize < 4]]) ifTrue:
@@ -3068,6 +3077,7 @@ StackInterpreterPrimitives >> primitiveStoreChar8IntoBytes [
