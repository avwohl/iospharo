 	addr := self maybeExternalAddressOf: rcvr startingAt: byteOffset size: byteSize.
 	addr = 0 ifTrue: [^self primitiveFailFor: PrimErrBadArgument].
+
+	"A store into the bytes of the receiver itself must respect the write barrier.
+	 A store through an ExternalAddress goes to outside memory and is not a store into the receiver."
+	((objectMemory fetchClassOf: rcvr) ~= objectMemory classExternalAddress
+		and: [objectMemory isObjImmutable: rcvr])
+			ifTrue: [^self primitiveFailFor: PrimErrNoModification].
 	
 	value := isSigned 
 		ifTrue:[objectMemory signed64BitValueOf: valueOop]
@@ -2910,6 +2916,7 @@ StackInterpreterPrimitives >> primitiveStoreBoolean8IntoBytes [
 	index := objectMemory integerValueOf: index.
 	bytes := objectMemory firstBytePointerOfDataObject: rcvr.
 	bytes == 0 ifTrue: [ ^ self primitiveFailFor: PrimErrBadArgument ].
+	(objectMemory isObjImmutable: rcvr) ifTrue: [ ^ self primitiveFailFor: PrimErrNoModification ].
 	
 	valueObject = objectMemory trueObject ifTrue: [
 		value := 1
@@ -2972,6 +2979,7 @@ StackInterpreterPrimitives >> primitiveStoreChar16IntoBytes [
 	value := objectMemory characterValueOf: valueObject.
 	bytes := objectMemory firstBytePointerOfDataObject: rcvr.
 	bytes == 0 ifTrue: [ ^ self primitiveFailFor: PrimErrBadArgument ].
+	(objectMemory isObjImmutable: rcvr) ifTrue: [ ^ self primitiveFailFor: PrimErrNoModification ].
 
 	byteSize := objectMemory numBytesOf: rcvr.
 	(index < 0 or: [index >= (byteSize - 1) or: [byteSize < 2]]) ifTrue:
@@ -3020,6 +3028,7 @@ StackInterpreterPrimitives >> primitiveStoreChar32IntoBytes [
 	value := self characterValueOf: valueObject.
 	bytes := objectMemory firstBytePointerOfDataObject: rcvr.
 	bytes == 0 ifTrue: [ ^ self primitiveFailFor: PrimErrBadArgument ].
