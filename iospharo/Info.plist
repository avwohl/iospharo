<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Launch screen — required by iOS 14+ App Store submission.
	     Dictionary form (no .storyboard file).  Solid color background
	     from the AccentColor asset; no splash image needed. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<!-- ATS policy: app only talks to files.pharo.org over HTTPS.
	     Whitelist that domain explicitly rather than
	     NSAllowsArbitraryLoads=true (which triggers App Store review
	     scrutiny and requires an explicit justification).  If a Pharo
	     image running inside the VM makes its own network calls via
	     FFI/sockets, those aren't subject to ATS — ATS only applies
	     to Foundation URLSession / CFNetwork. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>pharo.org</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
	<key>PharoCodeSize</key>
	<integer>67108864</integer>
	<key>PharoEdenSize</key>
	<integer>10485760</integer>
	<key>PharoHeadless</key>
	<false/>
	<key>PharoImageFile</key>
	<string>Pharo.image</string>
	<key>PharoLogLevel</key>
	<integer>1</integer>
	<!-- Old-space virtual-address ceiling (upper bound).  4 GB suits all
	     iOS / Catalyst devices: OS lazy-commits pages, and jetsam/OOM caps
	     actual physical use per-device.  Override via PHARO_MAX_OLD_SPACE
	     env var at launch. -->
	<key>PharoMaxOldSpaceSize</key>
	<integer>4294967296</integer>
	<!-- Soft GC threshold: when old-space committed bytes exceed this, the
	     next allocation triggers a full GC.  Small on low-RAM devices for
	     lower RSS; bigger on desktops for less GC work.  Override via
	     PHARO_INITIAL_OLD_SPACE env var. -->
	<key>PharoInitialOldSpace</key>
	<integer>134217728</integer>
	<key>NSMotionUsageDescription</key>
	<string>Pharo uses device motion sensors (accelerometer, gyroscope, magnetometer) for interactive programs and experiments.</string>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Pharo Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.pharo.image</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Pharo Image</string>
			<key>UTTypeIdentifier</key>
			<string>org.pharo.image</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>image</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
