# Local configuration (team ID, signing)
Local.xcconfig

*.pyc

# Build outputs.
# Match the SHAPE of a build directory, not a list of names.  This was ~25
# hardcoded entries; build-hunt/ was not among them, so 21 MB of object files,
# .o.d dependency files and a.out binaries were committed by accident
# (11750afa).  A denylist of names needs an edit every time someone invents a
# directory; a pattern does not.
*.o
*.a
build*/
*-build/
build-win-log*.txt
build-jit-log.txt

# Generated source (large)
cointerp.c

# Test images (large, downloaded)
test-images/
test_images/
images/

# Reference VM (download separately)
pharo-vm/

# Pharo runtime data
pharo-local/

# Stray files
stdbuf
pharo
pharo-ui

# Xcode derived data
DerivedData/
Frameworks/

# Xcode
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Standalone workspaces only — anchored deliberately.  A bare `*.xcworkspace`
# also matches iospharo.xcodeproj/project.xcworkspace, whose xcshareddata/
# holds SPM's Package.resolved.  With that ignored, the ZIPFoundation
# dependency floated on `upToNextMajorVersion from 0.9.0` with no lockfile in
# git, so any clone could resolve a different version than this one builds.
/*.xcworkspace

# Swift Package Manager
.swiftpm/
.build/
Packages/

